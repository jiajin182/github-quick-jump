{
  "manifest_version": 3,
  "name": "GitHub Quick Jump",
  "version": "1.1.0",
  "description": "在 GitHub 仓库页悬浮一个可拖动的按钮，一键跳转到 GitDiagram、DeepWiki、Gitingest、GitHub1s、GitHub.dev、StackBlitz；在这些站点上也能一键跳回 GitHub，并可自定义添加跳转地址。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "https://gitdiagram.com/*",
        "https://deepwiki.com/*",
        "https://gitingest.com/*",
        "https://github1s.com/*",
        "https://github.dev/*",
        "https://stackblitz.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}